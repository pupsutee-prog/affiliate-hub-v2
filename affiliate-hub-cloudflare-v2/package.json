{
  "name": "affiliate-hub-cloudflare-v2",
  "private": true,
  "version": "2.0.0-starter",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
    "db:local": "wrangler d1 execute affiliate-hub-db --local --file=./schema/001_init.sql",
